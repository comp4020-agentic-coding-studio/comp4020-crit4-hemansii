---
import Layout from "../layouts/Layout.astro";

// Two octaves of C major pentatonic — any combination of these notes sounds
// musical together, so there's no wrong note to hit.
const bars = [
  { note: "C4", freq: 261.626, key: "a" },
  { note: "D4", freq: 293.665, key: "s" },
  { note: "E4", freq: 329.628, key: "d" },
  { note: "G4", freq: 391.995, key: "f" },
  { note: "A4", freq: 440.0, key: "g" },
  { note: "C5", freq: 523.251, key: "h" },
  { note: "D5", freq: 587.33, key: "j" },
  { note: "E5", freq: 659.255, key: "k" },
  { note: "G5", freq: 783.991, key: "l" },
  { note: "A5", freq: 880.0, key: ";" },
];

// `--t` runs 0 (lowest bar) to 1 (highest), and every graduated dimension —
// bar length, wood colour, resonator length — is derived from it in CSS.
const slots = bars.map((bar, i) => ({
  ...bar,
  t: bars.length > 1 ? i / (bars.length - 1) : 0,
}));
---

<Layout
  title="Xylophone"
  description="A browser xylophone: click, drag or type across the bars — every note is in key, so nothing you play is wrong."
>
  <nav aria-label="Primary">
    <a class="skip-link" href="#instrument">Skip to the xylophone</a>
  </nav>
  <main id="instrument">
    <header class="masthead">
      <h1>Xylophone</h1>
      <p class="tagline" data-testid="intro">
        Ten bars · one scale · no wrong notes
      </p>
    </header>

    <div class="stage">
      <div class="xylophone" role="group" aria-label="Xylophone bars">
        <div class="bars">
          {
            slots.map((slot) => (
              <div class="slot" style={`--t: ${slot.t.toFixed(4)};`}>
                <div class="bar-zone">
                  <button
                    type="button"
                    class="bar"
                    data-note={slot.note}
                    data-freq={slot.freq}
                    aria-label={`Play ${slot.note}`}
                  >
                    <span class="bar-key">{slot.key.toUpperCase()}</span>
                  </button>
                </div>
                <div class="tube" aria-hidden="true" />
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <p class="hint">
      Strike a bar, drag for a run, or play the letters. Where you hit a bar
      makes it sound soft or ringing.
    </p>

    <div class="controls">
      <button type="button" id="record-btn" class="control control-record">
        <span class="control-dot" aria-hidden="true"></span>
        <span class="control-label">Record</span>
      </button>
      <button type="button" id="play-btn" class="control" disabled>
        <span class="control-tri" aria-hidden="true"></span>
        <span class="control-label">Play it back</span>
      </button>
      <p id="record-status" class="status" aria-live="polite"></p>
    </div>
  </main>
  <script src="../scripts/main.ts"></script>
</Layout>
